{
  "name": "@gglib/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -b && tsc -p tsconfig.test.json",
    "dev": "tsc -b && (tsc -b -w --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js)",
    "start": "node dist/main.js)",
    "test": "vitest run"
  },
  "dependencies": {
    "@gglib/db": "workspace:*",
    "@gglib/shared": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tarn": "^3.0.2",
    "tedious": "^19.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
