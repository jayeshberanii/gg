NODE_ENV=development
PORT=8081
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3001

# Legacy SQL Server shared with the desktop app. Use DBLibSQLTest for development.
DB_HOST=192.168.2.210
DB_PORT=1433
DB_NAME=DBLibSQLTest
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=12

# The desktop's Security dialog passwords (InputBoxProc: Delete, Lock/Unlock, …).
SECURITY_PASSWORD=
SECURITY_PASSWORD_ALT=
# Author Master › Utility › Lock Author / Unlock Author (its own password on the desktop).
AUTHOR_LOCK_PASSWORD=
# Kruti Master's Lock By Admin / Unlock By Admin.
KRUTI_LOCK_PASSWORD=
# Issue Master › Utility › Replace LibNo For Selected Records (its own password on the desktop).
ISSUE_REPLACE_PASSWORD=
# Graphics Master's Lock / Unlock (Ctrl+L / Ctrl+U) and Graphics Detail's Delete › File Path.
GRAPHICS_LOCK_PASSWORD=
# Lab issue: refuse a new request while the user (or the party) holds books delivered more than
# 30 days ago. The desktop switched this check off in v3.4.3.1 ("temporary"); true turns it on.
LAB_ISSUE_OLD_DUE_BLOCK=false

# Show Attachment(s) (CommonLibrary.frmAttachments). ATTACHMENT_SHARE is the folder as the desktop
# computers reach it (stored in Attachments.FilePath); ATTACHMENT_DIR is the same folder as this
# server reaches it (the mounted share, or the shared folder itself on the machine that hosts it).
ATTACHMENT_SHARE=\\192.168.0.210\Attachments\Production
ATTACHMENT_DIR=

# The desktop's other file folders (scanned books, e-books, title scans, graphics, reference
# scans, Graphics Detail's pictures and its temp folder). *_PATH is the folder as the desktop
# computers name it (the defaults are the desktop's own); *_DIR is the same folder as this server
# reaches it. LIBRARY_FILES_DIR is a parent for the ones without a *_DIR (ScanData, "B2 Ebook",
# ScanTitle, Graphics, scantesting, LibraryImages, tempgr under it), handy on a development PC.
LIBRARY_FILES_DIR=
# SCAN_PATH=\\192.168.0.50\ScanData
# SCAN_DIR=
# EBOOK_PATH=\\192.168.0.50\B2 Ebook
# EBOOK_DIR=
# TITLE_PATH=\\192.168.0.50\ScanTitle
# TITLE_DIR=
# GRAPHICS_PATH=\\192.168.0.50\Graphics
# GRAPHICS_DIR=
# REFERENCET_PATH=F:\scantesting
# REFERENCET_DIR=
# MAIN_ROOT_PATH=I:\LibraryImages
# MAIN_ROOT_DIR=
# GRAPHICS_DRIVE_PATH=Y:
# GRAPHICS_DRIVE_DIR=
# TEMPGR_PATH=d:\tempgr
# TEMPGR_DIR=
